{
    "version": 2,
    "builds": [
      {
        "src": "./back-end/src/server.js",
        "use": "@vercel/node"
      },
      {
        "src": "./front-end/**",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/back-end/src/server.js"
      },
      {
        "src": "/(.*)",
        "dest": "/front-end/$1"
      }
    ]
  }
  