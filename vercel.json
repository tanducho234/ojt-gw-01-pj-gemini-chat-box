{
  "version": 2,
  "builds": [
    {
      "src": "./back-end/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "./front-end/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/back-end/(.*)",
      "dest": "/front-end/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/back-end/src/server.js"
    }
  ]
}
